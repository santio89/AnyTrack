# Site URL (required in production for Open Graph, sitemap, and robots)
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Auth: Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Supabase (https://supabase.com) — database + file storage
# Project Settings → Database → Connection string (URI, use "Session" pooler for app runtime)
DATABASE_URL=
# Project Settings → API → Secret key (sb_secret_...) or legacy service_role
SUPABASE_URL=
# Legacy alias (optional if SUPABASE_URL is set)
# NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Storage → create a private bucket named anytrack (or override below)
SUPABASE_STORAGE_BUCKET=anytrack

# BYOK: encrypt user API keys at rest (required in production)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AI_CREDENTIALS_ENCRYPTION_KEY=

# Hosted AI: set at least one for extractions without user keys
# Vercel AI Gateway (default primary). On Vercel deploys, VERCEL_OIDC_TOKEN may substitute.
AI_GATEWAY_API_KEY=
OPENROUTER_API_KEY=

# Provider behavior (optional)
# AI_PRIMARY_PROVIDER=gateway
# AI_USE_FREE_MODELS=true
# AI_FREE_FALLBACK=false

# Hosted model IDs (optional)
# AI_VISION_MODEL=openai/gpt-4o
# AI_TEXT_MODEL=openai/gpt-4o-mini

# OpenRouter overrides (optional)
# OPENROUTER_VISION_MODEL=openai/gpt-4o
# OPENROUTER_TEXT_MODEL=openai/gpt-4o-mini
# OPENROUTER_MODEL=openai/gpt-4o
# OPENROUTER_FREE_VISION_MODEL=google/gemma-4-26b-a4b-it:free
# OPENROUTER_FREE_TEXT_MODEL=meta-llama/llama-3.2-3b-instruct:free
# OPENROUTER_FREE_MODEL=openrouter/free
# OPENROUTER_SITE_URL=http://localhost:3000
# OPENROUTER_APP_NAME=AnyTrack

# OpenAI overrides for user BYOK keys (optional)
# OPENAI_VISION_MODEL=gpt-4o
# OPENAI_TEXT_MODEL=gpt-4o-mini

# Email alerts: signed-in users only. Both required to enable.
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=

# Dev server (optional, npm run dev)
# PORT=3000
# HOST=localhost
